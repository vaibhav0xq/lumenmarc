# LumenMarc environment variables.
# Every variable is optional: the app runs with none of them set.
# Nothing loads this file automatically. For local development export the values in your shell
# (for example: cp .env.example .env, edit it, then: set -a; source .env; set +a) or set them in
# the host's project settings (Netlify, Vercel).

# Keyed Base mainnet RPC (Alchemy, QuickNode, Infura, Coinbase Developer Platform ...).
# Strongly recommended in production: the public Base RPCs are rate-limited and will
# occasionally make a refresh fail (the app then keeps its last snapshot and says so).
BASE_RPC_URL=

# Postgres connection string (Neon, Supabase, Replit ...). Use the pooled URL on serverless hosts.
# Backs the premium-history series only. Without it, labels/checks/portfolios still work
# and history endpoints reply "history disabled" instead of an empty chart.
# Apply the schema once with:  pnpm --filter @workspace/db run push
DATABASE_URL=

# Canonical public origin used in the API's shareText links, e.g. https://lumenmarc.netlify.app
# Falls back to the request's forwarded host when unset. The UI's embed snippet uses the page's own origin.
PUBLIC_APP_URL=

# Allows forced refreshes on GET /api/cron/snapshot (the scheduler hook that keeps history
# accumulating on serverless hosts). Send it as "Authorization: Bearer <CRON_SECRET>";
# Vercel Cron adds the header automatically, an external pinger on Netlify must set it.
CRON_SECRET=

# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Local development only (ignored on Replit and in production builds): where the Vite dev
# server forwards /api requests. Defaults to the API server's local default port.
API_PROXY_TARGET=http://localhost:8080
